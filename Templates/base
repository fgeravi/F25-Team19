<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{% block title %}My Site{% endblock %}</title>
  </head>
  <body>
    {% if messages %}
      <ul>
        {% for m in messages %}
          <li>{{ m }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if user.is_authenticated %}
      <p>Hi {{ user.username }} |
         <a href="{% url 'logout' %}">Logout</a></p>
    {% endif %}

    {% block content %}{% endblock %}
  </body>
</html>
